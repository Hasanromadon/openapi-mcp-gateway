# Glama source-server checks use the MCP stdio transport.
# The banking sample runs in mock mode and requires no external credentials.
FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY src/ ./src/
COPY samples/ ./samples/
RUN npm run build && npm prune --omit=dev

FROM node:20-alpine AS runner
ENV NODE_ENV=production
ENV MOCK=true
WORKDIR /app

COPY --from=builder --chown=node:node /app/package*.json ./
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/samples ./samples

USER node
ENTRYPOINT ["node", "dist/index.js"]
CMD ["--transport", "stdio", "--spec", "samples/bi-snap-banking.yaml", "--mock"]
